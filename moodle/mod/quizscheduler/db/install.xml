<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/quizscheduler/db" VERSION="20251002" COMMENT="XMLDB file for Moodle mod_quizscheduler"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="quizscheduler" COMMENT="Quiz scheduler instances">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="quizid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timeopen" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="timeclose" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="schedulestarttime" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="scheduleendtime" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="maxbookings" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="slotduration" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="60"/>
        <FIELD NAME="maxusersperslot" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="quiz" TYPE="foreign" FIELDS="quizid" REFTABLE="quiz" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    
    <TABLE NAME="quizscheduler_slots" COMMENT="Time slots for quiz scheduling">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="quizschedulerid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="starttime" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="endtime" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="maxparticipants" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="quizscheduler" TYPE="foreign" FIELDS="quizschedulerid" REFTABLE="quizscheduler" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="starttime" UNIQUE="false" FIELDS="starttime"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="quizscheduler_bookings" COMMENT="User bookings for time slots">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="slotid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="booked"/>
        <FIELD NAME="timebooked" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timestarted" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="timefinished" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="grade" TYPE="number" LENGTH="10" NOTNULL="false" DECIMALS="5"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="slot" TYPE="foreign" FIELDS="slotid" REFTABLE="quizscheduler_slots" REFFIELDS="id"/>
        <KEY NAME="user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_userid_status" UNIQUE="false" FIELDS="userid, status"/>
        <INDEX NAME="idx_slotid" UNIQUE="false" FIELDS="slotid"/>
        <INDEX NAME="idx_status" UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>